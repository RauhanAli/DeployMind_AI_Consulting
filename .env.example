# =============================================================================
# DeployMind environment configuration
# Copy to .env and adjust. NEVER commit a real .env file.
# Every value below is a development-only default.
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_ENV=development                      # development | test | staging | production
APP_NAME=DeployMind
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=json                          # json | console

# ---- PostgreSQL (pgvector) ---------------------------------------------------
# docker-compose exposes Postgres on host port 55432 to avoid clashing with local installs
DATABASE_URL=postgresql+psycopg://deploymind:deploymind@localhost:55432/deploymind
TEST_DATABASE_URL=postgresql+psycopg://deploymind:deploymind@localhost:55432/deploymind_test
POSTGRES_USER=deploymind
POSTGRES_PASSWORD=deploymind
POSTGRES_DB=deploymind

# ---- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:56379/0
CELERY_BROKER_URL=redis://localhost:56379/1
CELERY_RESULT_BACKEND=redis://localhost:56379/2
# true = run background jobs inline in the API process (handy without a worker)
CELERY_TASK_ALWAYS_EAGER=false

# ---- Authentication ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-development-only-jwt-secret-please-rotate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Cookie flags: set COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false

# ---- Secrets encryption ------------------------------------------------------
# Fernet key used to encrypt integration credentials and environment secrets.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=0pZQ4Hn0n3H0q2kQ1lZ8xGk3c9pYc6T2mJv4f1bXw0s=
SECRETS_BACKEND=fernet                   # fernet (encrypted in Postgres)

# ---- AI providers ------------------------------------------------------------
# mock = deterministic local providers, no paid API keys required (demo mode)
AI_PROVIDER=mock                         # mock | openai | anthropic
EMBEDDING_PROVIDER=mock                  # mock | openai
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# ---- Object storage (S3-compatible) -----------------------------------------
STORAGE_BACKEND=local                    # local | s3
STORAGE_LOCAL_PATH=./var/storage
S3_BUCKET=deploymind-documents
S3_ENDPOINT_URL=                         # e.g. http://localhost:9000 for MinIO
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20

# ---- Email -------------------------------------------------------------------
EMAIL_BACKEND=console                    # console | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@deploymind.local

# ---- Deployments -------------------------------------------------------------
DEPLOY_ADAPTER=local_docker              # local_docker | aws_ecs | github_actions
DOCKER_HOST=unix:///var/run/docker.sock
ASSISTANT_SERVICE_PATH=../assistant-service
LOCAL_DEPLOY_PORT_RANGE=18100-18199
LOCAL_DEPLOY_PUBLIC_HOST=localhost          # host shown to users for deployed containers
LOCAL_DEPLOY_PROBE_HOST=localhost           # host used for health checks (host.docker.internal inside compose)
# URL a locally deployed container uses to reach this API
PLATFORM_URL_FROM_CONTAINER=http://host.docker.internal:8000
GITHUB_TOKEN=
GITHUB_REPOSITORY=                       # owner/repo
GITHUB_DEPLOY_WORKFLOW=deploy.yml
AWS_ECS_CLUSTER=
AWS_ECS_SERVICE_PREFIX=deploymind
AWS_ECR_REPOSITORY=

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Observability -----------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=deploymind-api
METRICS_ENABLED=true

# ---- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=DeployMind
# Server-side URL Next.js uses to proxy /api/* to FastAPI
API_INTERNAL_URL=http://localhost:8000
