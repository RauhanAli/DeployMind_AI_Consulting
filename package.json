{
  "name": "deploymind",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:web": "pnpm --filter @deploymind/web dev",
    "build:web": "pnpm --filter @deploymind/web build",
    "test:web": "pnpm --filter @deploymind/web test",
    "test:e2e": "pnpm --filter @deploymind/web e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}